# Server
PORT=8080
NODE_ENV=test
# ALLOWED_ORIGINS é opcional em desenvolvimento, mas obrigatório em produção
# Para definir várias origins, é preciso separar elas com ';' (https://foo.com;https://bar.com)
ALLOWED_ORIGINS=http://localhost:3000

# Database
# Valor de referência: os testes sobrescrevem com a URL do container de teste
DATABASE_URL=postgres://admin:admin@localhost:5432/archivum_test

# SMTP
# Valores de referência: os testes sobrescrevem com as portas do container de teste
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_API_URL=http://localhost:5000
SMTP_FROM=archivum@biblioteca.test
