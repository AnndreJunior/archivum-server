# Server
PORT=8080
NODE_ENV=development
# ALLOWED_ORIGINS é opcional em desenvolvimento, mas obrigatório em produção
# Para definir várias origins, é preciso separar elas com ';' (https://foo.com;https://bar.com)
ALLOWED_ORIGINS=

# Autenticação
JWT_ACCESS_SECRET=shhhhhhhhhhhhhhhhhhhh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=shhhhhhhhhhhhhhhhhhhh
JWT_REFRESH_EXPIRES_IN=5d

# Database
DATABASE_URL=postgres://admin:admin@localhost:5432/archivum

# Bibliotecário inicial: garantido no startup da aplicação, caso não exista
LIBRARIAN_REGISTRATION=BIB-0001
LIBRARIAN_EMAIL=bibliotecario@archivum.test
LIBRARIAN_PASSWORD=troque-esta-senha

# SMTP
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_FROM=archivum@biblioteca.test
# Credenciais opcionais: sem elas o envio assume um servidor local sem autenticação
# SMTP_USER=
# SMTP_PASS=